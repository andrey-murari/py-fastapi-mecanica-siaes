erDiagram
    Pessoas {
        int PessoaID PK
        string PrimeiroNome
        string Sobrenome
        string Email
        string Telefone
        string Celular
        string CPF
        %% Info residencial %%
        int CepID FK
        string Complemento
        int NumeroResidencia
        %% Usuario associado a pessoa %%
        int UsuarioID FK
        %% Campos sistemicos %%
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    Usuarios {
        int UsuarioID PK
        int PessoaID FK
        int TipoUsuarioID FK
        string Login
        string Senha
        %% Campos sistemicos %%
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% Dominio com os perfis de usuario possiveis %%
    TiposUsuarios {
        int TipoUsuarioID PK
        string Tipo
        string Descricao
        %% Campos sistemicos %%
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    Clientes {
        int ClienteID PK
        int PessoaID FK
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% Sera buscado e populado CEP via API %%
    Enderecos {
        int CepID PK
        string Logradouro
        string Bairro
        string Cidade
        string UF
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% Poderia ser populado inicialmente em batch %%
    Veiculos {
        int VeiculoID PK
        string Modelo
        string Marca
        string AnoFabricacao
        string AnoModelo
        string Motorizacao
        int TipoCombustivelID PK
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    TiposCombustiveis {
        int TipoCombustivelID PK
        string Tipo
        string Descricao
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    VeiculosClientes {
        int VeiculoClienteID PK
        int VeiculoID FK
        int ClienteID FK
        string Placa
        string Cor
        string DescricaoVeiculo
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicos {
        int OrdemDeServicoID PK
        int ClienteID FK
        int VeiculoClienteID FK
        int ServicoID FK
        decimal ValorServico
        datetime DataSolicitacao
        datetime DataEntrega
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicosPecasInsumos {
        int OrdemDeServicoID PK
        int PecaInsumoID PK
        int Quantidade
        decimal ValorUnitario
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicosServicos {
        int OrdemDeServicoID FK
        int ServicoID FK
        decimal ValorServico
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% Poderia ser populado inicialmente em batch %%
    Servicos{
        int ServicoID PK
        string Descricao
        decimal ValorServico
        int UsuarioID FK
        %% Campos sistemicos %%
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% Poderia ser populado inicialmente em batch %%
    PecasInsumos {
        int PecaInsumoID PK
        string NomeMarca
        string Descricao
        decimal ValorUnitario
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    Estoques {
        int PecaInsumoID PK
        int Quantidade
        int TipoOperacaoEstoqueID FK
        datetime DataEntrada
    }
    TipoOperacaoEstoque {
        int TipoOperacaoEstoqueID PK
        string Tipo
        string Descricao
        %% Campos sistemicos %%
        int UsuarioID FK
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }

    Pessoas ||--|| Usuarios : "possui"
    Pessoas ||--o| Clientes : "pode ser"
    Pessoas ||--|| Enderecos : possui

    Usuarios }o--|| TiposUsuarios : possui

    Clientes ||--|{ VeiculosClientes: possui

    Veiculos ||--|| TiposCombustiveis: possui

    VeiculosClientes ||--|| Veiculos: possui

    OrdensDeServicos }o--|| Clientes: contem
    OrdensDeServicos }o--|| VeiculosClientes: contem

    OrdensDeServicos ||--|{ OrdensDeServicosServicos: contem
    OrdensDeServicos ||--|{ OrdensDeServicosPecasInsumos: contem

    OrdensDeServicosServicos ||--|| Servicos: contem
    OrdensDeServicosPecasInsumos ||--|| PecasInsumos: contem

