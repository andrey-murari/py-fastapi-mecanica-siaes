# adapters
FOR_GET_ADDRESS=viacep
FOR_STORING_DATA=sqlite

# webservices base urls
VIA_CEP_BASE_URL=https://viacep.com.br/ws/

# sqlite database url
SQLITE_URL=sqlite+pysqlite:///:memory:
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/mydatabase

# JWT auth (administration)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me