erDiagram
    Pessoas {
        string PersonID PK
        string NomeCompleto
        boolean FlagCliente
        string UsuarioID UK
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% user_id = login = CPF/CNPJ. Admin do .env nao tem linha. %%
    Usuarios {
        string UsuarioID PK
        string TipoUsuario
        string Login
        string Senha
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% CEP via ViaCEP. PK string 8 digitos. %%
    Enderecos {
        string CepID PK
        string Logradouro
        string Bairro
        string Cidade
        string UF
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    EnderecosPessoas {
        int EnderecoPessoaID PK
        string PersonID FK
        string CepID FK
        string Numero
        string Complemento
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    ContatosPessoas {
        int ContatoPessoaID PK
        string PersonID FK
        string TipoContato
        string ValorContato
        boolean FlagPreferencial
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    VeiculosClientes {
        int VeiculoClienteID PK
        string PersonID FK
        string Modelo
        string Marca
        string AnoFabricacao
        string AnoModelo
        string Motorizacao
        string TipoCombustivel
        string Placa
        string Cor
        string DescricaoVeiculo
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicos {
        int OrdemDeServicoID PK
        string PersonID FK
        int VeiculoClienteID FK
        int Quilometragem
        string DescricaoProblema
        string Diagnostico
        string MecanicoUsuarioID FK
        decimal ValorTotal
        decimal ValorTotalPecas
        decimal ValorTotalServicos
        int EstimativaTempoDias
        string ObservacaoOrcamento
        datetime DataSolicitacao
        datetime DataInicio
        datetime DataFim
        string Status
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicosPecasInsumos {
        int OrdemDeServicoPecaInsumoID PK
        int OrdemDeServicoID FK
        int PecaInsumoID FK
        int Quantidade
        decimal ValorTotal
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    OrdensDeServicosServicos {
        int OrdemDeServicoServicoID PK
        int OrdemDeServicoID FK
        int ServicoID FK
        string MecanicoUsuarioID FK
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    Servicos {
        int ServicoID PK
        string Descricao
        decimal ValorServico
        int TempoMedioMinutos
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    PecasInsumos {
        int PecaInsumoID PK
        string Descricao
        string Marca
        string Fabricante
        decimal ValorUnitario
        int QuantidadeDisponivel
        int UsuarioModificacaoID
        boolean FlagAtivo
        datetime DataInsercao
        datetime DataAtualizacao
    }
    %% order_part_id opcional (entrada inicial sem OS). unique quando preenchido. %%
    OperacoesEstoques {
        int OperacaoEstoqueID PK
        int PecaInsumoID FK
        string TipoOperacaoEstoque
        int Quantidade
        int OrdemDeServicoPecasInsumosID FK
        datetime DataOperacao
    }

    Enderecos ||--o{ EnderecosPessoas : possui
    EnderecosPessoas }o--|| Pessoas : possui

    Pessoas |o--o| Usuarios : "user_id unique nullable"
    Pessoas ||--o{ ContatosPessoas : possui
    Pessoas ||--o{ VeiculosClientes : possui

    OrdensDeServicos }o--|| Pessoas : contem
    OrdensDeServicos }o--|| VeiculosClientes : contem
    OrdensDeServicos }o--o| Usuarios : mecanico

    OrdensDeServicos ||--o{ OrdensDeServicosServicos : contem
    OrdensDeServicos ||--o{ OrdensDeServicosPecasInsumos : contem

    OrdensDeServicosServicos }o--|| Servicos : contem
    OrdensDeServicosServicos }o--o| Usuarios : mecanico
    OrdensDeServicosPecasInsumos }o--|| PecasInsumos : contem

    OperacoesEstoques }o--|| PecasInsumos : contem
    OperacoesEstoques |o--o| OrdensDeServicosPecasInsumos : contem
